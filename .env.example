# Copy to .env and fill in. Sourced by infra/do scripts; .env is gitignored.
DIGITALOCEAN_TOKEN=       # API token with read/write scope
NGC_API_KEY=              # nvcr.io login for the Isaac Sim base image
DO_REGION=                # optional; default nyc2 (check GPU stock with the sizes API)
DO_SIZE=                  # optional; default gpu-4000adax1-20gb
