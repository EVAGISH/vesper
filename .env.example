# Copy to .env and fill in. Sourced by infra/ scripts; .env is gitignored.
AWS_REGION=us-east-1
VESPER_BUCKET=            # e.g. vesper-theo-1a2b  (bucket names are global)
KEY_NAME=                 # EC2 key pair name for SSH
MY_IP=                    # optional; security-group.sh auto-detects if empty
